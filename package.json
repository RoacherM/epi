{
  "name": "epi",
  "version": "0.1.12",
  "private": true,
  "description": "A customizable terminal coding agent built on Pi, with a focused TUI, skills, MCP, hooks, and isolated subagents.",
  "type": "module",
  "bin": {
    "epi": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "benchmark": "node scripts/benchmark-adapter.mjs",
    "model-snapshot": "node scripts/model-snapshot.mjs",
    "pi:upgrade": "node scripts/pi-upgrade.mjs",
    "release": "node scripts/release.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "typebox": "1.3.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "@xterm/headless": "5.5.0",
    "semver": "7.8.5",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  }
}
